# Real environment files (never commit secrets)
.env
.env.*
!.env.example

# Private Growth Audit config fallback (belongs outside public_html on the
# server only; must never exist inside the repo working tree)
growth-audit-private/

# Generated deployment archives
*.zip
*.sha256.txt

# Bundled local dev runtime (portable PHP binary + its source zip)
.tools/

# Python bytecode cache
__pycache__/
*.pyc

# Logs
*.log

# Dependency folders
node_modules/
vendor/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup / duplicate copies
*.bak
*.orig
* - Copy.*
* copy.*
